{
  "name": "pi-makora-provider",
  "version": "1.12.28",
  "description": "Makora provider extension for pi - Access DeepSeek V4, GLM 5.2, Kimi K2.7 Code, Llama 3.3, Qwen 3.6, and more through the Makora inference API",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit && vitest run && node scripts/test-pi-compat.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-models": "node scripts/update-models.js",
    "typecheck": "tsc --noEmit",
    "test:pi": "node scripts/test-pi-compat.mjs"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "makora",
    "ai",
    "llm",
    "deepseek",
    "glm",
    "kimi",
    "llama",
    "qwen"
  ],
  "author": "monotykamary",
  "license": "MIT",
  "files": [
    "index.ts",
    "nan-collapse-guard.ts",
    "models.json",
    "deprecated-models.json",
    "custom-models.json",
    "patch.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "vitest": "^4.1.9",
    "@earendil-works/pi-ai": "1.0.0",
    "typescript": "6.0.3",
    "@types/node": "^25.9.1",
    "@earendil-works/pi-tui": "1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  }
}
